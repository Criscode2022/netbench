# Nest API (long-running Node — do not freeze the forwarding engine on a 10s serverless timeout)
PORT=3001
JWT_SECRET=change-me
DATABASE_URL=postgres://USER:PASSWORD@HOST/netbench?sslmode=require

# Optional: when set, API persists users/labs to Neon Postgres
# DATABASE_URL=

# Eve agent: local models only, no keys. Bionic (LM Studio's app) first, then Ollama.
# The Ollama fallback needs its 32K-context variant once: ollama create netbench-eve -f apps/eve-agent/ollama/Modelfile
# Optional Eve tuning (defaults in apps/eve-agent/agent/lib/model.ts, nest.ts, approval.ts)
# EVE_BIONIC_URL=http://127.0.0.1:1235/v1
# EVE_OLLAMA_URL=http://127.0.0.1:11434/v1
# EVE_MODEL=bionic/qwen3.8-9b-heretic-uncensored-mtplx
# Fallbacks, tried in order across calls when a step still fails (durable per session, primary retried after
# EVE_MODEL_RECOVER_MINUTES). Entries are <engine>/<model>, engine bionic or ollama.
# EVE_FALLBACK_MODELS=ollama/netbench-eve
# EVE_CONTEXT_TOKENS=65536           # cap on the context window eve assumes (compaction at 80 %)
# EVE_MODEL_RECOVER_MINUTES=15
# EVE_APPROVAL=auto                  # auto (never pause) | dangerous (pause on destructive calls) | once | always
# EVE_REQUIRE_APPROVAL=1             # legacy alias for EVE_APPROVAL=always
# EVE_NEST_RETRIES=2                 # retries per Nest call on network/timeout/429/5xx (Retry-After honoured)
# EVE_NEST_TIMEOUT_MS=25000          # per-attempt timeout (build_lab uses 60 s)
# Local: Nest on :3001. Production: the API's loopback address on the hosting platform.
NETBENCH_API_URL=http://127.0.0.1:3001
NETBENCH_API_TOKEN=

# Angular
# ng serve proxies /api → PORT 3001
